# 앱
DEBUG=false
API_PREFIX=/api

# 데이터베이스 (PostgreSQL + psycopg v3)
# docker-compose.yml로 띄운 DB 기준: 호스트 포트 5433
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/classic_literature

# CORS (콤마 구분) - 프론트(Vite) 주소
CORS_ORIGINS=http://localhost:5173

# OpenAI (tool calling / Agents SDK) - 실제 키를 채워야 /api/chat 동작
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
