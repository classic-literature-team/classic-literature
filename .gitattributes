# 모든 텍스트 파일의 개행을 LF로 통일한다.
# (Windows에서 편집해도 저장소에는 LF로 저장 -> CRLF/LF 충돌·소음 방지)
* text=auto eol=lf

# 명시적으로 텍스트로 취급할 확장자
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# 바이너리 파일은 건드리지 않는다.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.xlsx  binary